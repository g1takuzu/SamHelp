{
  "name": "SamHelp",
  "version": "1.0.0",
  "description": "SamHelp — приложение для управления контактами",
  "main": "electron/main.js",
  "author": "g1takuzu",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.moikontakty.desktop",
    "productName": "Мои контакты",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "icon": "assets/icon.ico",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Moi-Kontakty-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Мои контакты",
      "deleteAppDataOnUninstall": false
    }
  }
}


{
  "name": "samhelp",
  "version": "1.0.0",
  "description": "SamHelp — внутренний помощник сотрудников Самоката",
  "main": "electron/main.js",
  "author": "g1takuzu",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.samhelp.desktop",
    "productName": "SamHelp",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "artifactName": "SamHelp-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SamHelp",
      "deleteAppDataOnUninstall": false
    }
  }
}
